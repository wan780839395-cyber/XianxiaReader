{
  "version": 1,
  "scope": "First-party Swift imports and declared SwiftPM/XcodeGen dependencies; App areas are not separate compiler modules yet.",
  "sourceRoots": ["App", "Packages", "Tests"],
  "vendorProducts": {"ReadiumShared": "ReadiumToolkit", "ReadiumStreamer": "ReadiumToolkit", "ReadiumNavigator": "ReadiumToolkit"},
  "packages": {
    "ReaderSettings": {
      "path": "Packages/ReaderSettings",
      "packagePaths": ["../XianxiaCore"],
      "products": {"ReaderSettings": ["ReaderSettings"]},
      "targets": {
        "ReaderSettings": {"kind": "target", "path": "Sources/ReaderSettings", "dependencies": ["XianxiaCore"]},
        "ReaderSettingsTests": {"kind": "testTarget", "path": "Tests/ReaderSettingsTests", "dependencies": ["ReaderSettings", "XianxiaCore"]}
      }
    },
    "XianxiaCore": {
      "path": "Packages/XianxiaCore",
      "packagePaths": [],
      "products": {"XianxiaCore": ["XianxiaCore"], "TXTPerformanceProbe": ["TXTPerformanceProbe"]},
      "targets": {
        "CSQLite": {"kind": "systemLibrary", "path": "Sources/CSQLite", "dependencies": []},
        "CTextCodec": {"kind": "target", "path": "Sources/CTextCodec", "dependencies": []},
        "XianxiaCore": {"kind": "target", "path": "Sources/XianxiaCore", "dependencies": ["CSQLite", "CTextCodec"]},
        "TXTPerformanceProbe": {"kind": "executableTarget", "path": "Benchmarks/TXTPerformanceProbe", "dependencies": ["XianxiaCore"]},
        "XianxiaCoreTests": {"kind": "testTarget", "path": "Tests/XianxiaCoreTests", "dependencies": ["XianxiaCore", "CSQLite"]}
      }
    },
    "XianxiaReading": {
      "path": "Packages/XianxiaReading",
      "packagePaths": ["../XianxiaCore", "../../Vendor/ReadiumToolkit"],
      "products": {"ReadingInterfaces": ["ReadingInterfaces"], "ReadiumAdapter": ["ReadiumAdapter"]},
      "targets": {
        "ReadingInterfaces": {"kind": "target", "path": "Sources/ReadingInterfaces", "dependencies": ["XianxiaCore"]},
        "ReadiumAdapter": {"kind": "target", "path": "Sources/ReadiumAdapter", "dependencies": ["ReadingInterfaces", "XianxiaCore", "ReadiumShared", "ReadiumStreamer", "ReadiumNavigator"]}
      }
    }
  },
  "projectPackages": {"XianxiaCore": "Packages/XianxiaCore", "XianxiaReading": "Packages/XianxiaReading", "ReaderSettings": "Packages/ReaderSettings"},
  "projectTargets": {
    "XianxiaReader": {"kind": "application", "sources": ["App"], "dependencies": ["XianxiaCore", "ReadingInterfaces", "ReadiumAdapter", "ReaderSettings"]},
    "XianxiaReaderTests": {"kind": "bundle.unit-test", "sources": ["Tests/iOS", "Packages/ReaderSettings/Tests/ReaderSettingsTests"], "dependencies": ["XianxiaReader", "XianxiaCore", "ReadingInterfaces", "ReadiumAdapter", "ReaderSettings"]},
    "XianxiaReaderUITests": {"kind": "bundle.ui-testing", "sources": ["Tests/UI"], "dependencies": ["XianxiaReader"]}
  },
  "areas": [
    {"name": "App assembly", "target": "XianxiaReader", "files": ["App/AppRootView.swift", "App/AppServices.swift", "App/XianxiaReaderApp.swift"], "imports": ["Foundation", "ReaderSettings", "SwiftUI", "XianxiaCore"]},
    {"name": "Import", "target": "XianxiaReader", "path": "App/Import", "imports": ["Foundation", "ReadingInterfaces", "SwiftUI", "UIKit", "UniformTypeIdentifiers", "XianxiaCore"]},
    {"name": "Library", "target": "XianxiaReader", "path": "App/Library", "imports": ["CoreGraphics", "CoreTransferable", "Foundation", "ImageIO", "PhotosUI", "SwiftUI", "UIKit", "UniformTypeIdentifiers", "XianxiaCore"]},
    {"name": "Reader", "target": "XianxiaReader", "path": "App/Reader", "imports": ["Combine", "CoreGraphics", "CoreText", "Foundation", "ImageIO", "ReaderSettings", "ReadingInterfaces", "SwiftUI", "UIKit", "UniformTypeIdentifiers", "XianxiaCore"]},
    {"name": "Search", "target": "XianxiaReader", "path": "App/Search", "imports": ["Foundation", "ReadingInterfaces", "SwiftUI", "UIKit", "XianxiaCore"]},
    {"name": "Core", "target": "XianxiaCore", "path": "Packages/XianxiaCore/Sources/XianxiaCore", "imports": ["CSQLite", "CTextCodec", "CryptoKit", "Foundation"]},
    {"name": "Core tests", "target": "XianxiaCoreTests", "path": "Packages/XianxiaCore/Tests/XianxiaCoreTests", "imports": ["CSQLite", "Foundation", "XCTest", "XianxiaCore"]},
    {"name": "TXT desktop probe", "target": "TXTPerformanceProbe", "path": "Packages/XianxiaCore/Benchmarks/TXTPerformanceProbe", "imports": ["Darwin", "Dispatch", "Foundation", "Glibc", "XianxiaCore"]},
    {"name": "Reading interfaces", "target": "ReadingInterfaces", "path": "Packages/XianxiaReading/Sources/ReadingInterfaces", "imports": ["Foundation", "UIKit", "XianxiaCore"]},
    {"name": "Readium adapter", "target": "ReadiumAdapter", "path": "Packages/XianxiaReading/Sources/ReadiumAdapter", "imports": ["Foundation", "ReadingInterfaces", "ReadiumNavigator", "ReadiumShared", "ReadiumStreamer", "UIKit", "WebKit", "XianxiaCore"]},
    {"name": "iOS integration tests", "target": "XianxiaReaderTests", "path": "Tests/iOS", "imports": ["Combine", "CoreText", "CryptoKit", "Foundation", "ImageIO", "ReaderSettings", "ReadingInterfaces", "ReadiumAdapter", "SQLite3", "SwiftUI", "UIKit", "UniformTypeIdentifiers", "WebKit", "XCTest", "XianxiaCore", "XianxiaReader"]},
    {"name": "Settings logic", "target": "ReaderSettings", "path": "Packages/ReaderSettings/Sources/ReaderSettings", "imports": ["Combine", "Foundation", "XianxiaCore"]},
    {"name": "Settings contract tests", "target": "ReaderSettingsTests", "path": "Packages/ReaderSettings/Tests/ReaderSettingsTests", "imports": ["Foundation", "ReaderSettings", "XCTest", "XianxiaCore"]},
    {"name": "Native UI tests", "target": "XianxiaReaderUITests", "path": "Tests/UI", "imports": ["UIKit", "XCTest"]}
  ],
  "fileRules": {
    "Packages/ReaderSettings/Sources/ReaderSettings/ReaderSettingsPersistence.swift": {"imports": ["Combine", "Foundation", "XianxiaCore"], "reason": "R1 settings storage must not depend on reader interfaces, UI or navigation."}
  },
  "sharedTestSources": {
    "Packages/ReaderSettings/Tests/ReaderSettingsTests/ReaderSettingsPersistenceTests.swift": {"targets": ["ReaderSettingsTests", "XianxiaReaderTests"], "reason": "Run the identical seven contracts without an App host on macOS and retain them in the original iOS gate; lifecycle integration reuses the controlled storage fixture."}
  },
  "exceptions": [
    {"file": "App/AppServices.swift", "import": "ReadiumAdapter", "reason": "Existing assembly import; review and remove if unused during I5.", "removeIn": "I5"},
    {"file": "App/Library/LibraryView.swift", "import": "ReadiumAdapter", "reason": "Existing ReaderView construction creates ReadiumEngineFactory; move to App assembly in I5.", "removeIn": "I5"},
    {"file": "App/Library/LibraryViewModel.swift", "import": "ReadiumAdapter", "reason": "Existing import assembly creates ReadiumPublicationLoader; inject metadata capability in I5.", "removeIn": "I5"},
    {"file": "Tests/iOS/ReadiumSearchTests.swift", "import": "ReadiumShared", "reason": "Real Readium search extension integration fixture; not a production allowance.", "removeIn": "Review when separating integration test targets in I1"},
    {"file": "Tests/iOS/TXTReadingTests.swift", "import": "ReadiumShared", "reason": "Real TXT/Readium publication integration fixture; not a production allowance.", "removeIn": "Review when separating integration test targets in I1"}
  ]
}
